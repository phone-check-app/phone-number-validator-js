{
  "compilerOptions": {
    "outDir": "./dist",
    "target": "es2019",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "esModuleInterop": true,
    "sourceMap": false,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "declarationDir": "./dist",
    "declaration": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "typeRoots": [
      "./node_modules/@types",
      "./src"
    ],
    "types": ["node", "bun"]
  },
  "include": [
    "src"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "__tests__",
    "examples"
  ]
}
